{
   "manifest_version": 3,
   "name": "Hacker News Enhancement Suite",
   "short_name": "HNES",
   "description": "Hacker News Enhanced.",
   "version": "1.6.1",
   "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDOrcJ8f+KxguKzCiD6HO51eB+mP3zmjjL33XJ+5qvvM+s/AakzC8twSSBGzO1EBFsK1OPXa6fUXq6bRB5OBVJwjFOVXUXsgDTwetRmWzVUuq6eW6SopZQWnb6lNBjdEBsYj6sg/jT6j1F0c1gRnDLedWJzbdkOvib3dNeBYpHsxQIDAQAB",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "icons": {
      "128": "images/icon-128.png",
      "16": "images/icon-16.png",
      "48": "images/icon-48.png"
   },
   "permissions": [ "storage", "unlimitedStorage" ],
   "content_scripts": [ {
      "css": [ "style.css" ],
      "matches": [ "http://news.ycombinator.com/*", "https://news.ycombinator.com/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "css": [ "style.css" ],
      "js": [ "js/util.js", "js/linkify.js", "js/hn.js" ],
      "matches": [ "http://news.ycombinator.com/*", "https://news.ycombinator.com/*" ],
      "run_at": "document_end"
   }, {
      "js": [ "js/util.js", "js/hn.js" ],
      "matches": [ "http://hckrnews.com/*", "https://hckrnews.com/*" ],
      "run_at": "document_end"
   } ],
   "web_accessible_resources": [ {
      "resources": [ "images/spin.gif", "images/unvote.gif", "images/tag.svg" ],
      "matches": [ "http://news.ycombinator.com/*", "https://news.ycombinator.com/*" ]
   } ]
}
