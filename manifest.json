{
   "manifest_version": 3,
   "name": "Hacker News Enhancement Suite",
   "short_name": "HNES",
   "description": "Hacker News Enhanced.",
   "version": "1.7.1",
   "icons": {
      "128": "images/icon-128.png",
      "16": "images/icon-16.png",
      "48": "images/icon-48.png"
   },
   "permissions": [ "storage" ],
   "content_scripts": [ {
      "css": [ "style.css" ],
      "matches": [ "https://news.ycombinator.com/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "style.css" ],
      "js": [ "js/util.js", "js/linkify.js", "js/hn.js" ],
      "matches": [ "https://news.ycombinator.com/*" ],
      "run_at": "document_end"
   }, {
      "js": [ "js/util.js", "js/hn.js" ],
      "matches": [ "https://hckrnews.com/*" ],
      "run_at": "document_end"
   } ],
   "web_accessible_resources": [ {
      "resources": [ "images/tag.svg" ],
      "matches": [ "https://news.ycombinator.com/*" ]
   } ]
}
